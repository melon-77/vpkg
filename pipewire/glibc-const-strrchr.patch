With glibc 2.43 and newer, strrchr() of a const string returns a const pointer (C23), and PipeWire builds with
-Werror=discarded-qualifiers: "assignment discards 'const' qualifier". Keep the pointer const and cast where
the function hands it out, as it already does for the whole string.

--- a/spa/plugins/alsa/acp/compat.h	2026-11-19 16:22:49.764163895 -0800
+++ b/spa/plugins/alsa/acp/compat.h	2026-11-19 16:22:49.775743498 -0800
@@ -431,11 +431,11 @@
 
 static inline char *pa_path_get_filename(const char *p)
 {
-    char *fn;
+    const char *fn;
     if (!p)
         return NULL;
     if ((fn = strrchr(p, PA_PATH_SEP_CHAR)))
-        return fn+1;
+        return (char*) fn+1;
     return (char*) p;
 }
 
