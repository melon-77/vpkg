pkgname=libxxf86vm
pkgver=1.1.4
pkgrel=2
pkgdesc="libxxf86vm (graphics stack)"
license=custom
source=(libxxf86vm-1.1.4.tar.gz)
builddir=$srcdir/libXxf86vm-1.1.4
makedepends=(libxext-dev libx11-dev)
subpackages=(libxxf86vm-dev)
build(){ [ -x configure ] || autoreconf -fi; ./configure $conf_flags --disable-static --enable-malloc0returnsnull=no; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; }
