pkgname=vpm
pkgver=0.1.0
pkgrel=3
pkgdesc="Valence's own package manager, stage 1: the signed apk packages, a folder for every program (ROADMAP.md, phase 10)"
license=GPL-2.0-only
url=https://github.com/melon-77/v
# the source is this repository's vpm/ (vpm/README.md), not a tarball
builddir=$srcdir/vpm
makedepends=(openssl-dev zstd-dev)
# written in Rust (rule 46)
options=(rust)

prepare(){ cp -r $M/vpm $srcdir/vpm; rm -rf $srcdir/vpm/target; cd $srcdir/vpm; cargo_fetch; }
# ZSTD_SYS_USE_PKG_CONFIG: Valence's libzstd, never the copy zstd-sys would build for itself (rule 46); OpenSSL
# (signatures, digests, TLS through native-tls) is Valence's through pkg-config anyway
build(){ ZSTD_SYS_USE_PKG_CONFIG=1 cargo_build --bin vpm; }
package(){
  install -Dm755 $(cargo_out)/vpm $pkgdir/usr/bin/vpm
  install -Dm644 README.md $pkgdir/usr/share/doc/vpm/README.md
}
