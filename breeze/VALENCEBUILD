pkgname=breeze
pkgver=6.6.4
pkgrel=3
pkgdesc="breeze"
license="LGPL-2.1-or-later OR GPL-2.0-or-later (see sources)"
source=(breeze-6.6.4.tar.xz)
builddir=$srcdir/breeze-6.6.4
makedepends=(extra-cmake-modules kdecoration-dev kf6-frameworkintegration-dev kf6-kcmutils-dev kf6-kcolorscheme-dev kf6-kconfig-dev kf6-kconfigwidgets-dev kf6-kcoreaddons-dev kf6-kguiaddons-dev kf6-ki18n-dev kf6-kiconthemes-dev kf6-kirigami-dev kf6-kwidgetsaddons-dev kf6-kwindowsystem-dev qt6-qtbase-dev qt6-qtdeclarative-dev qt6-qtsvg-dev)
subpackages=(breeze-dev)
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins -DKDE_INSTALL_QMLDIR=lib/qt6/qml -DKDE_INSTALL_LIBEXECDIR=libexec -DKF_IGNORE_PLATFORM_CHECK=ON -DBUILD_WITH_QT6=ON -DQT_MAJOR_VERSION=6 -DBUILD_DOC=OFF -DBUILD_QT5=OFF; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -f $pkgdir/usr/share/wallpapers/Next/contents/images*/7680x2160.png $pkgdir/usr/share/wallpapers/Next/contents/images*/1440x2960.png; }
