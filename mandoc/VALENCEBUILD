pkgname=mandoc
pkgver=1.14.6
pkgrel=0
pkgdesc="man, apropos and whatis: reads manual pages (the -doc packages bring it)"
license="ISC AND BSD-2-Clause AND BSD-3-Clause"
url=https://mandoc.bsd.lv
source=(mandoc-1.14.6.tar.gz)
makedepends=(zlib-dev)
depends=(less)
# the index that man looks in first and that man -k and apropos search: rebuilt whenever a package adds or removes pages
triggers_mandoc=(/usr/share/man)
# tag-put-assertion.patch is upstream's tag.c 1.37 (26 April 2022, after this release): a page that tags a term both
# by hand and by default ended in a failed assertion. The file is Alpine's copy of that change.
prepare(){
  # configure compiles small test programs and runs them: they are Valence programs (rule 18)
  sed -i 's|^\tif \./test-\${1} 1>&3 2>&3; then$|\tif '"$M"'/scripts/valence-run ./test-${1} 1>\&3 2>\&3; then|' configure
  grep -q 'scripts/valence-run ./test-' configure || { echo "mandoc: configure no longer runs its tests that way"; return 1; }
  # less -T (jump to a tag) is asked of the build machine's less; Valence's has it. C.UTF-8 is built into glibc.
  cat > configure.local <<CONF
PREFIX=/usr
SBINDIR=/usr/bin
MANDIR=/usr/share/man
MANPATH_BASE=/usr/share/man
MANPATH_DEFAULT=/usr/share/man:/usr/local/share/man
OSNAME="Valence Linux"
UTF8_LOCALE=C.UTF-8
BINM_PAGER=less
HAVE_LESS_T=1
LN="ln -sf"
CC="$CC"
CFLAGS="$CFLAGS"
LDFLAGS="$LDFLAGS"
CONF
}
build(){ ./configure; grep -q '^#define HAVE_WCHAR 1' config.h || { echo "mandoc: no UTF-8 output (the wchar test failed)"; return 1; }
  make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install
  local p; for p in man apropos whatis makewhatis mandoc; do [ -e $pkgdir/usr/bin/$p ] || { echo "mandoc: no $p"; return 1; }; done; }
