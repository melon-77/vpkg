#!/bin/sh
# Calamares job "finish": everything the console installer does after copying the system, for the
# partitions Calamares made. Runs on the live system; the new system is mounted at $1.
set -eu
ROOT=$1
PATH=/usr/bin
REPO=/media/valence/valence/repo
if [ -f /var/lib/octet/world ] && command -v oct >/dev/null 2>&1; then
  ARCH=$(oct --print-arch)
else
  ARCH=$(apk --print-arch)
fi
say(){ echo "Valence: $*"; }
devof(){ awk -v m="$1" '$2==m{d=$1} END{print d}' /proc/mounts; }
uuidof(){ blkid -s UUID -o value "$1"; }

rootdev=$(devof "$ROOT"); bootdev=$(devof "$ROOT/boot"); efidev=$(devof "$ROOT/boot/efi")
[ -n "$rootdev" ] || { echo "cal-finish: nothing mounted at $ROOT" >&2; exit 1; }
[ -n "$bootdev" ] || bootdev=$rootdev

say "fstab"
rootfs=$(blkid -s TYPE -o value "$rootdev")
# Valence's Btrfs layout: mount.conf made @ (the system), @home and @log; the snapshots' and the swap file's
# subvolumes are made here, as valence-install makes them (AGENTS.md, "Snapshots and rollback"). A root that manual
# partitioning put on another filesystem is set up as before, and has no snapshots.
BTRFSOPT=noatime,compress=zstd:1
layout=plain
subvol(){ btrfs subvolume show "$1" 2>/dev/null | head -n 1; }
if [ "$rootfs" = btrfs ] && [ "$(subvol "$ROOT")" = @ ] && [ "$bootdev" != "$rootdev" ]; then
  layout=valence
  top=$(mktemp -d); mount -t btrfs -o subvolid=5 "$rootdev" "$top"
  for s in @snapshots @swap; do [ -d "$top/$s" ] || btrfs subvolume create "$top/$s" >/dev/null; done
  chmod 750 "$top/@snapshots"; chmod 700 "$top/@swap"
  umount "$top"; rmdir "$top"
  mkdir -p "$ROOT/swap"; mkdir -p -m 750 "$ROOT/.snapshots"
  mount -t btrfs -o subvol=@swap,$BTRFSOPT "$rootdev" "$ROOT/swap"
fi
ruuid=$(uuidof "$rootdev")
{
  echo "# <device>                                  <mountpoint> <type> <options>              <dump> <pass>"
  if [ $layout = valence ]; then
    echo "UUID=$ruuid  /            btrfs  subvol=@,$BTRFSOPT           0  0"
    [ "$(subvol "$ROOT/home")" = @home ] && echo "UUID=$ruuid  /home        btrfs  subvol=@home,$BTRFSOPT       0  0"
    [ "$(subvol "$ROOT/var/log")" = @log ] && echo "UUID=$ruuid  /var/log     btrfs  subvol=@log,$BTRFSOPT        0  0"
    echo "UUID=$ruuid  /.snapshots  btrfs  subvol=@snapshots,$BTRFSOPT  0  0"
    echo "UUID=$ruuid  /swap        btrfs  subvol=@swap,$BTRFSOPT       0  0"
  else
    echo "UUID=$ruuid  /            $rootfs    defaults,noatime       0      1"
  fi
  [ "$bootdev" != "$rootdev" ] && echo "UUID=$(uuidof "$bootdev")                              /boot        vfat   defaults,umask=0077    0      2"
  [ -n "$efidev" ] && echo "UUID=$(uuidof "$efidev")                              /boot/efi    vfat   defaults,umask=0077    0      2"
  # partitions that manual partitioning gave a mount point of their own (a separate /home, a data disk)
  awk -v root="$ROOT" -v rd="$rootdev" 'index($2, root "/") == 1 && $1 ~ /^\/dev\// && $1 != rd { print $1, substr($2, length(root) + 1), $3 }' /proc/mounts |
    while read -r dev mp fs; do
      case $mp in /boot|/boot/efi|/dev|/dev/*|/run|/run/*|/proc|/sys|/sys/*|/swap) continue ;; esac
      case $fs in ext4|ext3|ext2|xfs|btrfs|f2fs|vfat|exfat|ntfs3) echo "UUID=$(uuidof "$dev")  $mp  $fs  defaults,noatime  0  2" ;; esac
    done
  echo "tmpfs                                       /tmp         tmpfs  nosuid,nodev,mode=1777 0      0"
} > "$ROOT/etc/fstab"

say "swap file"   # zram (the zram service) comes first; the swap file catches the rest
memk=$(awk '/MemTotal/{print $2}' /proc/meminfo)
freek=$(df -Pk "$ROOT" | awk 'NR==2{print $4}')
swapm=$(( memk / 1024 )); [ $swapm -gt 8192 ] && swapm=8192
[ $(( freek / 1024 )) -lt $(( swapm * 4 )) ] && swapm=$(( freek / 1024 / 8 ))
if [ "$swapm" -ge 256 ]; then
  if [ $layout = valence ]; then
    # (a swap file on Btrfs must not be copy-on-write or compressed: mkswapfile sees to both)
    btrfs filesystem mkswapfile --size ${swapm}m --uuid clear "$ROOT/swap/swapfile" >/dev/null
    echo "/swap/swapfile                              none         swap   defaults,pri=10        0      0" >> "$ROOT/etc/fstab"
  else
    fallocate -l ${swapm}M "$ROOT/swapfile" 2>/dev/null || dd if=/dev/zero of="$ROOT/swapfile" bs=1M count=$swapm status=none
    chmod 600 "$ROOT/swapfile"; mkswap "$ROOT/swapfile" >/dev/null
    echo "/swapfile                                   none         swap   defaults,pri=10        0      0" >> "$ROOT/etc/fstab"
  fi
fi

if [ -f "$ROOT/var/lib/octet/world" ] && command -v oct >/dev/null 2>&1; then
  PM_DEL="oct --plain --root $ROOT --arch $ARCH --no-commit-hooks"
  PM_ADD="oct --plain --root $ROOT --arch $ARCH --repository $REPO/$ARCH/Packages.adb --no-commit-hooks"
else
  PM_DEL="apk --root $ROOT --arch $ARCH --repositories-file /dev/null --no-cache --no-commit-hooks"
  PM_ADD="apk --root $ROOT --arch $ARCH --repositories-file /dev/null --repository $REPO/$ARCH/Packages.adb --no-cache --no-commit-hooks"
fi

say "removing the live-only installer packages"
if [ -f /usr/share/valence/profiles/live-only ]; then
  $PM_DEL del $(cat /usr/share/valence/profiles/live-only) >/dev/null || true
fi

say "packages from the ISO"
mkdir -p "$ROOT/var/lib/valence"
cp -a "$REPO" "$ROOT/var/lib/valence/repo"
{ echo "$(cat /usr/share/valence/repo-url)/$ARCH/Packages.adb"; echo "/var/lib/valence/repo/$ARCH/Packages.adb"; } > "$ROOT/etc/apk/repositories"

luksdev=
case $rootdev in
  /dev/mapper/*|/dev/dm-*) luksdev=$(cryptsetup status "$rootdev" | awk '$1=="device:"{print $2}') ;;
esac
if [ -n "$luksdev" ]; then
  say "encrypted root on $luksdev: unlock initramfs"
  mkdir -p "$ROOT/etc/valence"; : > "$ROOT/etc/valence/encrypted-root"
  $PM_ADD add cryptsetup
  chroot "$ROOT" valence-mkinitramfs
  rm -f "$ROOT/etc/crypttab"   # the initramfs opens root; nothing else is encrypted
fi

vmsvcs=
if virt=$(valence-detect-virt); then
  say "running in a $virt VM: guest tools"
  $PM_ADD add valence-vm-guest >/dev/null 2>&1 \
    && vmsvcs=$(cat "$ROOT/usr/share/valence/vm-guest.services" 2>/dev/null)
fi

say "services"
svcs="getty-tty1 getty-tty2 getty-tty3 mdevd syslogd klogd crond ntpd dhcp"
prof=/usr/share/valence/profiles/desktop.services
[ -f $prof ] || prof=/usr/share/valence/profiles/base.services
if [ -f $prof ]; then
  for s in $(grep -v '^#' $prof); do
    case $s in -*) svcs=$(printf '%s\n' $svcs | grep -vxF -- "${s#-}" | xargs) ;; *) svcs="$svcs $s" ;; esac
  done
fi
mkdir -p "$ROOT/var/service"
for s in $svcs $vmsvcs; do if [ -d "$ROOT/etc/sv/$s" ]; then ln -sfn /etc/sv/$s "$ROOT/var/service/$s"; fi; done

# a wish list on a USB stick or another drive (valence-wishlist.txt; ROADMAP.md, phase 8), as valence-install does
tdisk=/dev/$(basename "$(readlink -f /sys/class/block/${bootdev##*/}/..)")
if wish=$(valence-wish --find --exclude "$tdisk" 2>/dev/null); then
  say "wish list $wish"
  mkdir -p "$ROOT/etc/valence"; cp "$wish" "$ROOT/etc/valence/wishlist.txt"
  valence-wish --root "$ROOT" "$wish" || say "the wish list was not applied completely (above); after the first start: sudo valence-wish /etc/valence/wishlist.txt"
fi
chroot "$ROOT" dbus-uuidgen --ensure 2>/dev/null || true

say "bootloader"
# A system that cannot start must not end in "All done": GRUB reads /boot before anything is unlocked, so /boot has
# to be a plain partition (partition.conf keeps it out of "Encrypt system"; manual partitioning can still get this
# wrong), and the installs below are checked.
case $(blkid -s TYPE -o value "$bootdev") in
  vfat|ext2|ext3|ext4|btrfs|xfs) ;;
  *) echo "cal-finish: /boot is on $bootdev, which GRUB cannot read ($(blkid -s TYPE -o value "$bootdev")). /boot must be a plain, unencrypted partition." >&2; exit 1 ;;
esac
if [ "$(lsblk -dno TYPE "$bootdev" 2>/dev/null)" = crypt ]; then
  echo "cal-finish: /boot is on $bootdev, which is encrypted: GRUB could not read the kernel. /boot must be a plain partition." >&2; exit 1
fi
# the whole disk that holds /boot
bootpart=${bootdev##*/}
disk=/dev/$(basename "$(readlink -f /sys/class/block/$bootpart/..)")
if [ -d /sys/firmware/efi ] || [ -n "$efidev" ]; then
  efidir=/boot; [ -n "$efidev" ] && efidir=/boot/efi
  EFI_TARGET=x86_64-efi; [ "$ARCH" = x86 ] && EFI_TARGET=i386-efi
  chroot "$ROOT" grub-install --target=$EFI_TARGET --efi-directory=$efidir --boot-directory=/boot --bootloader-id=valence 2>&1 | grep -v '^Installing for' || true
  # also the removable-media path, for firmware that forgets boot entries, but only on an EFI partition that is
  # Valence's alone: next to Windows or another system, EFI/BOOT is their fallback loader
  if [ -z "$(ls "$ROOT$efidir/EFI" 2>/dev/null | grep -v -i -x -e BOOT -e valence)" ]; then
    chroot "$ROOT" grub-install --target=$EFI_TARGET --efi-directory=$efidir --boot-directory=/boot --removable --no-nvram 2>&1 | grep -v '^Installing for' || true
  fi
  # (grub-install also fails when only the firmware's boot entry could not be written, so look at what is there)
  if [ -z "$(find "$ROOT$efidir/EFI" -iname '*.efi' 2>/dev/null | head -n 1)" ]; then
    echo "cal-finish: GRUB was not installed on the EFI partition ($efidir)" >&2; exit 1
  fi
  # BIOS boot code as well when the disk has room for it (GPT with a BIOS boot partition); it may well not have
  chroot "$ROOT" grub-install --target=i386-pc --boot-directory=/boot "$disk" 2>&1 | grep -v '^Installing for' || true
else
  # a BIOS machine starts from this and nothing else
  if ! out=$(chroot "$ROOT" grub-install --target=i386-pc --boot-directory=/boot "$disk" 2>&1); then
    printf '%s\n' "$out" >&2; echo "cal-finish: GRUB could not be installed on $disk" >&2; exit 1
  fi
fi
[ -f "$ROOT/boot/grub/grub.cfg" ] || mkdir -p "$ROOT/boot/grub"
VALENCE_ROOT_DEV="$rootdev" VALENCE_BOOT_DEV="$bootdev" chroot "$ROOT" valence-update-grub
say "done"
