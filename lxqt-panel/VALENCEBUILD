pkgname=lxqt-panel
pkgver=2.4.0
pkgrel=2
pkgdesc="The LXQt panel"
license="LGPL-2.1-or-later (see sources)"
url=https://lxqt-project.org
source=(lxqt-panel-2.4.0.tar.xz)
makedepends=(alsa-lib-dev kf6-kwindowsystem-dev kf6-solid-dev layer-shell-qt-dev libdbusmenu-lxqt-dev liblxqt-dev libqtxdg-dev libsysstat-dev libx11-dev libxcb-dev libxkbcommon-dev libxtst-dev lm-sensors-dev lxqt-build-tools lxqt-globalkeys-dev lxqt-menu-data pulseaudio-dev qt6-qtbase-dev qt6-qtwayland-dev)
subpackages=(lxqt-panel-dev)
pkg_dev(){ default_dev; amove usr/share/cmake; }
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DUPDATE_TRANSLATIONS=OFF -DQt6LinguistTools_DIR=$M/hosttools/qt6/lib/cmake/Qt6LinguistTools -DNETWORKMONITOR_PLUGIN=OFF -DCPULOAD_PLUGIN=OFF; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; }
