pkgname=jq
pkgver=1.8.2
pkgrel=1
pkgdesc="Command-line JSON processor"
license="MIT AND BSD-2-Clause"
url=https://jqlang.org
source=(jq-1.8.2.tar.gz)
makedepends=()
subpackages=(jq-dev)
build(){ ./configure $conf_flags --disable-static --with-oniguruma=builtin; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; }
pkg_dev(){ default_dev; if [ -e "$pkgdir/usr/bin/onig-config" ]; then amove usr/bin/onig-config; fi; }
