pkgname=openssh
pkgver=10.6_p2
pkgrel=0
pkgdesc="OpenSSH client and server (ssh, scp, sftp, sshd)"
license=BSD-2-Clause
url=https://www.openssh.com
source=(openssh-10.6p2.tar.gz)
builddir=$srcdir/openssh-10.6p2
makedepends=(openssl-dev zlib-dev libxcrypt-dev)
options=(keepdirs)
build(){
  ./configure $conf_flags --sysconfdir=/etc/ssh --libexecdir=/usr/libexec/openssh \
    --with-privsep-path=/var/empty --with-privsep-user=sshd --with-pid-dir=/run \
    --without-pam --disable-strip --disable-lastlog
  make -j$JOBS
}
package(){
  make DESTDIR=$pkgdir install-nokeys
  mkdir -p $pkgdir/var/empty
  chmod 755 $pkgdir/var/empty
  install -Dm755 /dev/stdin $pkgdir/etc/sv/sshd/run <<'EOF'
#!/bin/sh
exec 2>&1
mkdir -p /var/empty
chmod 755 /var/empty
ssh-keygen -A >/dev/null 2>&1 || true
exec /usr/bin/sshd -D -e
EOF
}
