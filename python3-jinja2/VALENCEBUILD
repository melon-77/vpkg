pkgname=python3-jinja2
pkgver=3.1.6
pkgrel=1
pkgdesc="Jinja2 templates for Python (elogind's build renders files with it)"
license=BSD-3-Clause
url=https://palletsprojects.com/p/jinja/
source=(jinja2-3.1.6.tar.gz)
# py_install puts the module into python3's site-packages, whose name it reads from the sysroot
makedepends=(python3)
builddir=$srcdir/jinja2-3.1.6
depends=(python3 python3-markupsafe)
package(){ py_install Jinja2 src/jinja2; }
