pkgname=perl
pkgver=5.44.0
pkgrel=1
pkgdesc="Perl 5: the scripting language (autoconf, automake, texinfo and git's tools are written in it)"
license="Artistic-1.0-Perl OR GPL-1.0-or-later"
url=https://www.perl.org
source=(perl-5.44.0.tar.xz)
subpackages=(perl-doc)
# libxcrypt-dev: perl's crypt() is libxcrypt's on glibc
makedepends=(zlib-dev bzip2-dev libxcrypt-dev)
# Configure compiles test programs and runs them, and the build runs miniperl and perl all the way through
options=(runhere)
# Configure runs as if native: with options=(runhere), what Valence's compiler links runs on the build machine
# (rule 18). It only needs to be told where Valence's headers and libraries are; Config.pm gets plain paths, and
# the compiler's name without runhere's link flags, back in package().
build(){
  export BUILD_ZLIB=False ZLIB_INCLUDE=$SYSROOT/usr/include ZLIB_LIB=$SYSROOT/usr/lib
  export BUILD_BZIP2=0 BZIP2_INCLUDE=$SYSROOT/usr/include BZIP2_LIB=$SYSROOT/usr/lib
  ./Configure -des -Dcc="$CC" -Dld="$CC" -Dar="$AR" -Dnm="$NM" -Dranlib="$RANLIB" \
    -Doptimize="$CFLAGS" -Dldflags="$LDFLAGS" -Dlddlflags="-shared $LDFLAGS" \
    -Dcccdlflags=-fPIC -Dccdlflags=-rdynamic \
    -Dlibpth="$SYSROOT/usr/lib" -Dglibpth="$SYSROOT/usr/lib" -Dplibpth= -Dloclibpth= -Dlocincpth= \
    -Dusrinc="$SYSROOT/usr/include" -Uusenm \
    -Dprefix=/usr -Dvendorprefix=/usr -Dsiteprefix=/usr/local \
    -Dprivlib=/usr/share/perl5/core_perl -Darchlib=/usr/lib/perl5/core_perl \
    -Dvendorlib=/usr/share/perl5/vendor_perl -Dvendorarch=/usr/lib/perl5/vendor_perl \
    -Dsitelib=/usr/local/share/perl5/site_perl -Dsitearch=/usr/local/lib/perl5/site_perl \
    -Dman1dir=/usr/share/man/man1 -Dman3dir=/usr/share/man/man3 -Dman1ext=1 -Dman3ext=3pm \
    -Dsiteman1dir=/usr/local/share/man/man1 -Dsiteman3dir=/usr/local/share/man/man3 \
    -Dusethreads -Duseshrplib -Duselargefiles -Ud_csh -Dd_semctl_semun \
    -Dcf_by=valence -Dcf_email=root@localhost -Dperladmin=root@localhost \
    -Dmyhostname=localhost -Dmydomain=.localdomain -Dosvers=valence -Dmyuname='linux valence'
  # libperl.so gets a SONAME (so: dependencies need one); LD_RUN_PATH= keeps MakeMaker from writing the sysroot's
  # library directory into Compress::Raw::Zlib's and ::Bzip2's RPATH
  make -j$JOBS LD_RUN_PATH= SHRPLDFLAGS='$(LDDLFLAGS) -Wl,-soname,libperl.so'
}
package(){
  make DESTDIR=$pkgdir install
  # the build used Valence's cross compiler and the sysroot; modules built on Valence itself use gcc and /usr
  local c=$pkgdir/usr/lib/perl5/core_perl f
  for f in $c/Config.pm $c/Config_heavy.pl $c/CORE/config.h; do     # (config.h: the preprocessor command, CPPRUN)
    sed -i -e "s| $RUNHERE_LDFLAGS||g" -e "s|$SYSROOT||g" -e "s|$TARGET-||g" "$f"; done
  # Configure also writes down where the cross compiler searches (libpth, incpth), the build machine's own libc and
  # library directories (libc, plibpth) and the cross ar's path: Valence's instead
  sed -i -E "s|^(libpth=').*'|\1/usr/lib /usr/local/lib'|; s|^(libspath=').*'|\1 /usr/lib /usr/local/lib'|; s|^(incpth=').*'|\\1/usr/include'|; s|^(plibpth=').*'|\\1'|; s|^(full_ar=').*'|\\1/usr/bin/ar'|; s|^(libc=').*'|\\1/usr/lib/libc.so.6'|" $c/Config_heavy.pl
  sed -i -E "s|^(    libpth => ').*',|\1/usr/lib /usr/local/lib',|" $c/Config.pm
  if grep -rl -e 'dynamic-linker' -e "$M" -e x86_64-linux-gnu $pkgdir/usr/lib/perl5 $pkgdir/usr/share/perl5 2>/dev/null | grep -v '\.so$' | head -n 5 | grep .; then
    echo "perl: the files above still name the build's sysroot or its link flags" >&2; return 1; fi
  rm -f $pkgdir/usr/lib/perl5/core_perl/.packlist
}
pkg_doc(){ default_doc; amove usr/share/perl5/core_perl/pod; }
