pkgname=coreutils
pkgver=9.12
pkgrel=1
pkgdesc="The GNU core utilities: ls, cp, mv, cat, sort and about a hundred more"
license=GPL-3.0-or-later
url=https://www.gnu.org/software/coreutils/
source=(coreutils-9.12.tar.xz)
makedepends=(acl-dev attr-dev openssl-dev)
# The GNU tools take over BusyBox's command names: each ships a real file in /usr/bin where BusyBox only had a link
# (BusyBox's trigger puts its link back when the package goes). kill and uptime are procps-ng's and hostname stays
# BusyBox's: coreutils has its own of each and installs none of them unless asked.
# FORCE_UNSAFE_CONFIGURE: configure stops when root runs it, and a Valence build machine builds as root.
build(){
  FORCE_UNSAFE_CONFIGURE=1 ./configure $conf_flags --disable-nls --without-selinux --without-libgmp --disable-libcap \
    --with-openssl
  make -j$JOBS
}
package(){ make DESTDIR=$pkgdir install; }
