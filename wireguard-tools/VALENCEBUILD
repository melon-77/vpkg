pkgname=wireguard-tools
pkgver=1.0.20260223
pkgrel=1
pkgdesc="WireGuard VPN userspace tools (wg, wg-quick; split tunnels without DNS= only until nft/resolvconf are added)"
license=GPL-2.0-only
url=https://www.wireguard.com
source=(wireguard-tools-1.0.20260223.tar.xz)
makedepends=(linux-headers)
depends=(bash iproute2)
options=(keepdirs)
# Do not override CFLAGS on make's command line (src/Makefile appends -DRUNSTATEDIR, -std=gnu99, -isystem uapi/linux)
build(){ make -C src RUNSTATEDIR=/run -j$JOBS; }
package(){
  make -C src DESTDIR=$pkgdir PREFIX=/usr RUNSTATEDIR=/run WITH_BASHCOMPLETION=yes WITH_WGQUICK=yes WITH_SYSTEMDUNITS=no install
  install -dm700 $pkgdir/etc/wireguard
}
