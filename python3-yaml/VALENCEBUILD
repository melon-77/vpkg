pkgname=python3-yaml
pkgver=6.0.3
pkgrel=1
pkgdesc="PyYAML: YAML for Python (Mesa's build reads YAML with it)"
license=MIT
url=https://pyyaml.org
source=(pyyaml-6.0.3.tar.gz)
# py_install puts the module into python3's site-packages, whose name it reads from the sysroot
makedepends=(python3)
builddir=$srcdir/pyyaml-6.0.3
depends=(python3)
# the pure-Python parser; the optional libyaml binding (_yaml) is left out
package(){ py_install PyYAML lib/yaml; }
