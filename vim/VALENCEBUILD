pkgname=vim
pkgver=9.2.1381
pkgrel=0
pkgdesc="Vi IMproved text editor"
license=Vim
url=https://www.vim.org
source=(vim-9.2.1381.tar.gz)
makedepends=(ncurses-dev)
build(){
  vim_cv_toupper_broken=no \
  vim_cv_terminfo=yes \
  vim_cv_tty_group=world \
  vim_cv_getcwd_broken=no \
  vim_cv_stat_ignores_slash=no \
  vim_cv_memmove_handles_overlap=yes \
  vim_cv_tgetent=zero \
  ac_cv_small_wchar_t=no \
  ./configure $conf_flags --with-features=huge --with-tlib=ncursesw \
    --disable-gui --without-x --disable-nls --enable-multibyte
  make -j$JOBS
}
package(){ make DESTDIR=$pkgdir STRIP=true install; }
