pkgname=findutils
pkgver=4.11.0
pkgrel=1
pkgdesc="GNU find and xargs"
license=GPL-3.0-or-later
url=https://www.gnu.org/software/findutils/
source=(findutils-4.11.0.tar.xz)
build(){ ./configure $conf_flags --disable-nls --without-selinux; make -j$JOBS; }
# find and xargs only: locate searches a database that updatedb has to rebuild every day, and nothing here runs it
package(){ make DESTDIR=$pkgdir install
  rm -rf $pkgdir/usr/bin/locate $pkgdir/usr/bin/updatedb $pkgdir/usr/libexec $pkgdir/var \
    $pkgdir/usr/share/man/man1/locate.1 $pkgdir/usr/share/man/man1/updatedb.1 $pkgdir/usr/share/man/man5; }
