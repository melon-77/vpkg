pkgname=lxqt-session
pkgver=2.4.0
pkgrel=2
pkgdesc="The LXQt session manager"
license="LGPL-2.1-or-later (see sources)"
url=https://lxqt-project.org
source=(lxqt-session-2.4.0.tar.xz)
makedepends=(eudev-dev kf6-kwindowsystem-dev layer-shell-qt-dev liblxqt-dev libproc2-dev libqtxdg-dev libx11-dev lxqt-build-tools qt6-qtbase-dev qtxdg-tools-dev xdg-user-dirs)
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DUPDATE_TRANSLATIONS=OFF -DQt6LinguistTools_DIR=$M/hosttools/qt6/lib/cmake/Qt6LinguistTools -DWITH_LIBUDEV=ON; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; }
