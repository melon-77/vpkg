pkgname=plasma5support
pkgver=6.6.4
pkgrel=2
pkgdesc="plasma5support"
license="LGPL-2.1-or-later OR GPL-2.0-or-later (see sources)"
source=(plasma5support-6.6.4.tar.xz)
builddir=$srcdir/plasma5support-6.6.4
makedepends=(extra-cmake-modules kf6-kconfig-dev kf6-kcoreaddons-dev kf6-kguiaddons-dev kf6-kholidays-dev kf6-ki18n-dev kf6-kidletime-dev kf6-kio-dev kf6-kjobwidgets-dev kf6-knotifications-dev kf6-kservice-dev kf6-kunitconversion-dev kf6-networkmanager-qt-dev kf6-solid-dev libksysguard-dev libx11-dev libxfixes-dev plasma-activities-dev qt6-qtbase-dev qt6-qtdeclarative-dev)
subpackages=(plasma5support-dev)
depends_plasma5support_dev=("plasma5support=$pkgver-r$pkgrel" kf6-kservice-dev)
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins -DKDE_INSTALL_QMLDIR=lib/qt6/qml -DKDE_INSTALL_LIBEXECDIR=libexec -DKF_IGNORE_PLATFORM_CHECK=ON -DBUILD_WITH_QT6=ON -DQT_MAJOR_VERSION=6 -DBUILD_DOC=OFF; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; }
