#!/bin/sh
for d in /usr/lib/modules/*; do [ -d "$d" ] && depmod -a "${d##*/}"; done
# encrypted installs boot through a small initramfs; rebuild it for the new kernel
[ -f /etc/valence/encrypted-root ] && [ -x /usr/bin/valence-mkinitramfs ] && /usr/bin/valence-mkinitramfs
[ -x /usr/bin/valence-update-grub ] && [ -f /boot/grub/grub.cfg ] && /usr/bin/valence-update-grub
exit 0
