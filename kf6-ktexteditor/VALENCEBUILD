pkgname=kf6-ktexteditor
pkgver=6.24.0
pkgrel=2
pkgdesc="kf6-ktexteditor"
license="LGPL-2.1-or-later OR GPL-2.0-or-later (see sources)"
source=(kf6-ktexteditor-6.24.0.tar.xz)
builddir=$srcdir/ktexteditor-6.24.0
makedepends=(extra-cmake-modules kf6-breeze-icons-dev kf6-karchive-dev kf6-kauth-dev kf6-kcodecs-dev kf6-kcolorscheme-dev kf6-kcompletion-dev kf6-kconfig-dev kf6-kconfigwidgets-dev kf6-kcoreaddons-dev kf6-kguiaddons-dev kf6-ki18n-dev kf6-kio-dev kf6-kitemviews-dev kf6-kjobwidgets-dev kf6-kparts-dev kf6-kwidgetsaddons-dev kf6-kxmlgui-dev kf6-sonnet-dev kf6-syntax-highlighting-dev qt6-qtbase-dev qt6-qtdeclarative-dev qt6-qtspeech-dev)
subpackages=(kf6-ktexteditor-dev)
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins -DKDE_INSTALL_QMLDIR=lib/qt6/qml -DKDE_INSTALL_LIBEXECDIR=libexec -DKF_IGNORE_PLATFORM_CHECK=ON -DBUILD_WITH_QT6=ON -DQT_MAJOR_VERSION=6 -DBUILD_DOC=OFF; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; }
