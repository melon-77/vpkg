pkgname=util-linux
pkgver=2.41.3
pkgrel=1
pkgdesc="Disk, filesystem and system utilities (fdisk, lsblk, mount, ...)"
license="GPL-2.0-or-later AND LGPL-2.1-or-later AND BSD-3-Clause"
url=https://github.com/util-linux/util-linux
source=(util-linux-2.41.3.tar.xz)
makedepends=(zlib-dev ncurses-dev)
subpackages=(util-linux-dev libblkid libuuid libmount libsmartcols libfdisk)
depends_libmount="libblkid"
depends_libfdisk="libblkid libuuid"
for _l in libblkid libuuid libmount libsmartcols libfdisk; do eval "pkgdesc_${_l}='util-linux $_l library'"; done
# --disable-all-programs also switches off every program that has no --enable option of its own, whatever the
# command line says: --enable-findmnt, --enable-mkswap, --enable-findfs and --enable-blkdiscard were "unrecognized
# options", and Valence had no findmnt. Take these four out of that default in configure itself.
_extra="findmnt mkswap findfs blkdiscard"
prepare(){ local p
  for p in $_extra; do
    sed -i "/^  enable_$p=\$ul_default_estate\$/,/^  fi\$/{s/^  enable_$p=.*/  enable_$p=check/; s/build_$p=no/build_$p=yes/}" configure
    [ "$(grep -c "^  enable_$p=\$ul_default_estate\$" configure)" = 0 ] || { echo "util-linux: configure no longer has the lines for $p"; return 1; }
  done; }
build(){
  ./configure $conf_flags --disable-all-programs --enable-libblkid --enable-libuuid --enable-libmount \
    --enable-libsmartcols --enable-libfdisk --enable-fdisks --enable-lsblk --enable-blkid \
    --enable-mount --enable-losetup --enable-wipefs --enable-swapon --enable-partx --enable-uuidgen \
    --enable-lscpu --enable-fstrim --enable-mountpoint --enable-lsfd=no \
    --without-systemd --without-udev --without-python --without-readline --without-ncurses --without-tinfo \
    --disable-liblastlog2 --disable-pam-lastlog2 --disable-nls --disable-makeinstall-chown --disable-makeinstall-setuid \
    --disable-asciidoc --disable-poman --without-econf --disable-year2038
  make -j$JOBS
}
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/bash-completion
  local p; for p in $_extra; do [ -x $pkgdir/usr/bin/$p ] || { echo "util-linux: $p was not built"; return 1; }; done; }
pkg_libblkid(){ amove 'usr/lib/libblkid.so.*'; }
pkg_libuuid(){ amove 'usr/lib/libuuid.so.*'; }
pkg_libmount(){ amove 'usr/lib/libmount.so.*'; }
pkg_libsmartcols(){ amove 'usr/lib/libsmartcols.so.*'; }
pkg_libfdisk(){ amove 'usr/lib/libfdisk.so.*'; }
pkg_dev(){ default_dev; }
